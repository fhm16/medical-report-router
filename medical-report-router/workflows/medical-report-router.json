      "id": "8f94e11c-9338-4a62-b7c0-69e4d1fe3f85"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.response;\nconst parsed = JSON.parse(raw);\nreturn [{ json: parsed }];"
      },
